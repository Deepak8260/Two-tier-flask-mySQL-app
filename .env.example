# .env.example
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# .env is listed in .gitignore and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=messagesdb

# Optional Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
